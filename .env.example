# Local development settings. Contains your ntfy topic — never commit this file.
# Usage:  source .env && python3 -m casio_watch --loop

export NTFY_TOPIC=REPLACE_WITH_YOUR_TOPIC
export STATE_PATH=./state.json
export HEARTBEAT_PATH=./heartbeat
export MIN_DISCOUNT_PCT=10
export POLL_SECONDS=60
export LOG_LEVEL=INFO
