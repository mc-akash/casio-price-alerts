# Local settings. Contains your ntfy topic — never commit this file.
#
# Read directly by docker compose (env_file), so no 'export' prefixes.
# For a plain shell run, export the whole file at once:
#   set -a && source .env && set +a && python3 -m casio_watch --loop

NTFY_TOPIC=REPLACE_WITH_YOUR_TOPIC
STATE_PATH=./state.json
HEARTBEAT_PATH=./heartbeat
MIN_DISCOUNT_PCT=10
POLL_SECONDS=60
LOG_LEVEL=INFO
